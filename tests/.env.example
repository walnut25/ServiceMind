# API endpoints
API_BASE_URL=http://127.0.0.1:8081
API_PREFIX=/api/v1
API_TIMEOUT=20
HEALTH_TIMEOUT=120

# Bootstrap administrator created by AdminBootstrap at first startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# Only needed for expired/forged token tests; must match the backend JWT_SECRET.
# When empty those tests are skipped explicitly.
JWT_SECRET=qa-local-jwt-secret-at-least-32-bytes-long
JWT_TTL_SECONDS=1800

# Database used for optional read-only consistency assertions
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=smart_service
DB_USERNAME=smart_service
DB_PASSWORD=smart_service
DB_CHECKS_ENABLED=true

# AI is disabled by default; tests rely on the deterministic 503 path.
AI_CHAT_ENABLED=false

# Prefix for every object this run creates
QA_RUN_ID=local

# Browser tests
FRONTEND_DIST=frontend/dist
UI_BROWSER_CHANNEL=chrome   # empty -> Playwright bundled Chromium
UI_HEADLESS=true
UI_SCREENSHOTS=true
UI_TIMEOUT_MS=15000
