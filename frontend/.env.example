# === Backend API ===
VITE_API_BASE_URL=/api/v1

# === E2E Tests (Playwright) ===
# Test user credentials - do NOT commit real passwords
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8081
# Set to true to reuse an installed Google Chrome instead of Playwright Chromium.
E2E_USE_INSTALLED_CHROME=false
E2E_REQUESTER_USERNAME=e2e-requester
E2E_REQUESTER_PASSWORD=E2eRequesterPass123!
E2E_AGENT_USERNAME=e2e-agent
E2E_AGENT_PASSWORD=E2eAgentPass123!
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=Admin123!
